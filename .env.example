# Copy to .env and fill in the key. Every value except the key has a default.
OPENAI_API_KEY=

# Model that turns the question into a QueryPlan (reasoning effort: low).
PLANNER_MODEL=gpt-5.4-mini
# Model that labels unclear intervention names for drug networks (reasoning effort: none).
LABEL_MODEL=gpt-5.4-nano

# Largest trial set fetched in full. Above this, only exact-count questions are answered.
MAX_TRIALS=20000
# ClinicalTrials.gov responses kept in memory are reused until the registry publishes new data (about
# once a day). This lifetime applies only when that cannot be checked; 0 turns the cache off.
CACHE_TTL_SECONDS=3600
# Plain-text account of the latest question; emptied when the next one arrives.
# RUN_LOG_PATH=logs/last_run.txt
